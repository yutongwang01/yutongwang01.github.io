            <img src="/assets/images/travel/xian-3454.jpg" alt="The Giant Wild Goose Pagoda lit at night beyond a lively square" width="1800" height="1350" loading="lazy" decoding="async">
            <img src="/assets/images/travel/xian-3444.jpg" alt="A crescent moon above a golden illuminated roof and red lanterns" width="1800" height="1350" loading="lazy" decoding="async">
            <img src="/assets/images/travel/xian-3414.jpg" alt="Rows of terracotta warriors beneath the roof of an excavation hall" width="1800" height="1350" loading="lazy" decoding="async">
            <img src="/assets/images/travel/xian-3424.jpg" alt="Terracotta figures standing in an excavated pit" width="1800" height="1350" loading="lazy" decoding="async">
            <img src="/assets/images/travel/xian-3431.jpg" alt="A bronze chariot with four horses displayed behind museum glass" width="1800" height="1350" loading="lazy" decoding="async">
          </div>
        </div>
      </dialog>

      {% for album in japanAlbums %}
      <dialog class="travel-album" id="{{ album.id }}-album" aria-labelledby="{{ album.id }}-album-title">
        <div class="travel-album__inner">
          <header class="travel-album__header">
            <div><p class="travel-album__meta">{{ album.region }} / August 2017</p><h3 id="{{ album.id }}-album-title">{{ album.name }}</h3></div>
            <button class="travel-album__close" type="button" data-travel-close>Close</button>
          </header>
          <p class="travel-album__intro">{{ album.intro }}</p>
          <div class="travel-album__gallery travel-album__gallery--japan{% if album.photos.length == 1 %} travel-album__gallery--single{% endif %}">
            {% for photo in album.photos %}
            <img src="/assets/images/travel/{{ photo.file }}.jpg" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy" decoding="async">
            {% endfor %}
          </div>
        </div>
      </dialog>
      {% endfor %}

