            {% for photo in daliPhotos %}
            <img src="/assets/images/travel/dali-{{ photo.id }}.jpg" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy" decoding="async">
            {% endfor %}
          </div>
        </div>
      </dialog>

